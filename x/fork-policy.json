{
  "forbidden_import_prefixes": [
    "go.kenn.io/agentsview/internal/postgres",
    "go.kenn.io/agentsview/internal/clickhouse",
    "go.kenn.io/agentsview/internal/duckdb",
    "go.kenn.io/agentsview/internal/vector",
    "go.kenn.io/agentsview/internal/telemetry",
    "go.kenn.io/agentsview/internal/sshremote",
    "go.kenn.io/agentsview/internal/chromehost",
    "github.com/minio/minio-go",
    "github.com/aws/aws-sdk-go",
    "github.com/aws/aws-sdk-go-v2",
    "github.com/jackc/pgx",
    "github.com/ClickHouse/clickhouse-go",
    "github.com/marcboeker/go-duckdb",
    "github.com/duckdb/duckdb-go",
    "github.com/asg017/sqlite-vec-go-bindings",
    "github.com/posthog/posthog-go",
    "github.com/apache/arrow-go",
    "github.com/apache/arrow"
  ],
  "behavior_checks": [
    {
      "package": "./internal/server",
      "pattern": "^TestRemovedActionsRefuseBeforeLaunching$"
    },
    {
      "package": "./internal/localnet",
      "pattern": "^TestLocalClient"
    },
    {
      "package": "./internal/rawclient",
      "pattern": "^TestUploadCannotSendCredentialsOrObjects$"
    },
    {
      "package": "./internal/remotesync",
      "pattern": "^TestProductionRemoteSourceNeverContactsPeer$"
    },
    {
      "package": "./internal/insight",
      "pattern": "^TestUnconfiguredInsightCannotLaunch$"
    },
    {
      "package": "./internal/config",
      "pattern": "^TestLoadRejects(LegacyS3Roots|PostgreSQL|ClickHouse|RemovedWebIntegrations)$"
    },
    {
      "package": "./cmd/agentsview",
      "pattern": "^TestPrepareServeRuntimeConfig(PortPolicy|RejectsInvalidPorts|ExplicitPortCollision)$"
    }
  ]
}
